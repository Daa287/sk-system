//@version=6
// SK-System · Mo-Zonen (sk_mo 1.3.2) · Stand 09.10.2026 14:09 · Kurs 83'333
// Feste Werte vom SK-Server - bei Aenderungen neu von der Webseite kopieren. Keine Anlageberatung.
// Details zu jeder Zone: Maus auf die Beschriftung rechts neben dem Kasten.
indicator("SK Mo-Zonen 09.10.2026 14:09", overlay = true, max_boxes_count = 100, max_lines_count = 100, max_labels_count = 100)
showLong  = input.bool(true, "Long-Zonen", group = "Anzeige")
showShort = input.bool(true, "Short-Zonen (nur Beobachtung)", group = "Anzeige")
showZiel  = input.bool(true, "Offene Ziele 161,8-200 %", group = "Anzeige")
showDV    = input.bool(true, "Doppelter Vorteil", group = "Anzeige")
showSL    = input.bool(true, "SL 78,6 %", group = "Anzeige")
showFibo  = input.bool(true, "Fibo-Welle", group = "Anzeige")
showD1    = input.bool(true, "D1 SMA50 / EMA50 (live)", group = "Anzeige")
zW1 = input.bool(true, "W1", group = "Zeitrahmen der Zonen", inline = "tf")
zD1 = input.bool(true, "D1", group = "Zeitrahmen der Zonen", inline = "tf")
zH4 = input.bool(true, "H4", group = "Zeitrahmen der Zonen", inline = "tf")
z15 = input.bool(true, "15m", group = "Zeitrahmen der Zonen", inline = "tf")
maxH   = input.float(10, "Max. Zonenhoehe in % vom Kurs", minval = 1, group = "Zeitrahmen der Zonen")
links  = input.int(80, "Kaesten: Kerzen nach links", minval = 5, maxval = 400, group = "Layout")
rechts = input.int(25, "Kaesten: Kerzen nach rechts", minval = 5, maxval = 400, group = "Layout")
showFibTxt = input.bool(false, "Fibo-Beschriftung im Chart", group = "Layout")
showDash = input.bool(true, "Dashboard anzeigen", group = "Dashboard")
dashPos  = input.string("oben rechts", "Position", options = ["oben rechts", "unten rechts", "oben links", "unten links"], group = "Dashboard")
dashGr   = input.string("winzig", "Schrift", options = ["winzig", "klein", "normal"], group = "Dashboard")
dashFib  = input.bool(true, "Fibo- und D1-Zeilen", group = "Dashboard")
dashDeck = input.bool(true, "Hintergrund deckend", group = "Dashboard")
dashBg = dashDeck ? color.rgb(19, 23, 34) : color.new(color.black, 45)
ts = dashGr == "winzig" ? size.tiny : dashGr == "klein" ? size.small : size.normal

f_zone(float lo, float hi, color c, int tr) =>
    box.new(bar_index - links, hi, bar_index + rechts, lo, border_color = color.new(c, 40), bgcolor = color.new(c, tr))
f_tag(float y, color c, string t, string tip) =>
    label.new(bar_index + rechts, y, t, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = size.small, tooltip = tip)
f_sl(float y, color c, string t) =>
    line.new(bar_index + rechts - 6, y, bar_index + rechts, y, color = c, width = 2)
    label.new(bar_index + rechts - 6, y, t, style = label.style_label_right, color = color.new(c, 100), textcolor = c, size = size.tiny)
f_fib(float y, string t, string tip) =>
    line.new(bar_index - links, y, bar_index + rechts, y, color = color.new(color.gray, 40), style = line.style_dotted)
    if showFibTxt
        label.new(bar_index + rechts - 14, y, t, style = label.style_label_right, color = color.new(color.gray, 100), textcolor = color.gray, size = size.tiny, tooltip = tip)
f_in(float lo, float hi) => close >= lo and close <= hi
f_stat(float lo, float hi) =>
    float d = close > hi ? (close - hi) / close * 100 : close < lo ? (lo - close) / close * 100 : 0.0
    f_in(lo, hi) ? "IN ZONE" : (close > hi ? "↓ " : "↑ ") + str.replace_all(str.tostring(d, "0.0"), ".", ",") + " %"
f_zahl(float v) => str.replace_all(str.tostring(math.round(v), "#,###"), ",", "'")

d1sma = request.security(syminfo.tickerid, "D", ta.sma(close, 50)[1], lookahead = barmerge.lookahead_on)
d1ema = request.security(syminfo.tickerid, "D", ta.ema(close, 50)[1], lookahead = barmerge.lookahead_on)
plot(showD1 ? d1sma : na, "D1 SMA50", color = color.new(color.blue, 0), linewidth = 2)
plot(showD1 ? d1ema : na, "D1 EMA50", color = color.new(color.purple, 0), linewidth = 2)

if barstate.islastconfirmedhistory
    if showLong and (zD1 or zH4) and 5.9 <= maxH
        f_zone(67655.48, 72597.93, color.teal, 82)
        f_tag(70126.71, color.teal, "LONG 67'655-72'598 · D1/H4", "D1/H4 Gesamtkorrektur: Z 57'800 A 66'956 B 62'275 C 87'396 · Zone 67'655-72'598 · SL 64'134")
        if showSL
            f_sl(64133.62, color.teal, "SL 64'134")
    if showLong and (zW1 or zD1 or zH4) and 17.6 <= maxH
        f_zone(67740.66, 82377.32, color.teal, 82)
        f_tag(75058.99, color.teal, "LONG 67'741-82'377 · W1/D1/H4", "W1/D1/H4 Gesamtkorrektur: Z 38'555 A 73'777 B 49'000 C 126'200 · Zone 67'741-82'377 · SL 57'311")
        if showSL
            f_sl(57310.95, color.teal, "SL 57'311")
    if showLong and (zD1 or zH4) and 5.0 <= maxH
        f_zone(70640.18, 74835.33, color.teal, 82)
        f_tag(72737.76, color.teal, "LONG 70'640-74'835 · D1/H4", "D1/H4 Gesamtkorrektur: Z 62'275 A 65'474 B 62'535 C 87'396 · Zone 70'640-74'835 · SL 67'651")
        if showSL
            f_sl(67650.82, color.teal, "SL 67'651")
    if showShort and (z15) and 0.7 <= maxH
        f_zone(82037.74, 82586.89, color.red, 82)
        f_tag(82312.31, color.red, "SHORT 82'038-82'587 · 15m", "15m Gesamtkorrektur: Z 83'682 A 83'062 B 83'606 C 80'394 · Zone 82'038-82'587 · SL 82'978")
        if showSL
            f_sl(82978.20, color.red, "SL 82'978")
    if showShort and (z15) and 1.0 <= maxH
        f_zone(82824.28, 83636.14, color.red, 82)
        f_tag(83230.21, color.red, "SHORT 82'824-83'636 · 15m", "15m BC-Level: Z 87'396 A 82'875 B 85'255 C 80'394 · Zone 82'824-83'636 · SL 84'215")
        if showSL
            f_sl(84214.65, color.red, "SL 84'215")
    if showShort and (zD1 or zH4 or z15) and 1.5 <= maxH
        f_zone(83696.33, 84946.80, color.red, 82)
        f_tag(84321.57, color.red, "SHORT 83'696-84'947 · D1/H4/15m", "H4/15m Gesamtkorrektur: Z 86'999 A 84'972 B 86'699 C 80'394 · Zone 83'696-84'799 · SL 85'586\nD1/H4/15m BC-Level: Z 87'396 A 82'563 B 87'220 C 80'394 · Zone 83'807-84'947 · SL 85'759\nH4/15m Gesamtkorrektur: Z 87'220 A 83'888 B 86'999 C 80'394 · Zone 83'807-84'947 · SL 85'759")
        if showSL
            f_sl(85759.14, color.red, "SL 85'759")
    if (showZiel or showDV) and (z15)
        f_zone(76213.52, 77940.44, color.lime, 72)
        f_tag(77076.98, color.lime, "Ziel SHORT 76'214-77'940 = DV LONG", "161,8-200 % · 15m\nDoppelter Vorteil LONG: in 76'214-77'940")
    if (showZiel or showDV) and (zD1 or zH4 or z15)
        f_zone(77554.66, 79400.74, color.lime, 72)
        f_tag(78477.70, color.lime, "Ziel SHORT 77'555-79'401 = DV LONG", "161,8-200 % · D1/H4/15m\nDoppelter Vorteil LONG: in 77'555-79'401")
    if showFibo
        f_fib(81181.82, "Fib L 50 % 81'182", "Fibo LONG 74'968 -> 87'396")
        f_fib(79715.35, "Fib L 61,8 % 79'715", "Fibo LONG 74'968 -> 87'396")
        f_fib(79106.39, "Fib L 66,7 % 79'106", "Fibo LONG 74'968 -> 87'396")
        f_fib(77627.50, "Fib L 78,6 % 77'627", "Fibo LONG 74'968 -> 87'396")
    if showFibo
        f_fib(83894.61, "Fib S 50 % 83'895", "Fibo SHORT 87'396 -> 80'394")
        f_fib(84720.86, "Fib S 61,8 % 84'721", "Fibo SHORT 87'396 -> 80'394")
        f_fib(85063.97, "Fib S 66,7 % 85'064", "Fibo SHORT 87'396 -> 80'394")
        f_fib(85897.22, "Fib S 78,6 % 85'897", "Fibo SHORT 87'396 -> 80'394")

var table dash = table.new(dashPos == "oben rechts" ? position.top_right : dashPos == "unten rechts" ? position.bottom_right : dashPos == "oben links" ? position.top_left : position.bottom_left, 5, 10, bgcolor = dashBg, border_width = 0, frame_width = 1, frame_color = color.new(color.gray, 70))
if barstate.islast and showDash
    table.cell(dash, 0, 0, "SK 09.10. 14:09", text_color = color.gray, text_size = ts)
    table.cell(dash, 1, 0, "Zone", text_color = color.gray, text_size = ts)
    table.cell(dash, 2, 0, "TF", text_color = color.gray, text_size = ts)
    table.cell(dash, 3, 0, "SL", text_color = color.gray, text_size = ts)
    table.cell(dash, 4, 0, "Kurs", text_color = color.gray, text_size = ts)
    table.clear(dash, 0, 1, 4, 9)
    int r = 1
    if showShort and (zD1 or zH4 or z15) and 1.5 <= maxH
        table.cell(dash, 0, r, "S", text_color = color.red, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "83'696–84'947", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "D1/H4/15m", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "85'759", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(83696.33, 84946.80), text_color = color.white, text_size = ts, bgcolor = f_in(83696.33, 84946.80) ? color.new(color.red, 45) : na)
        r += 1
    if showShort and (z15) and 1.0 <= maxH
        table.cell(dash, 0, r, "S", text_color = color.red, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "82'824–83'636", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "15m", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "84'215", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(82824.28, 83636.14), text_color = color.white, text_size = ts, bgcolor = f_in(82824.28, 83636.14) ? color.new(color.red, 45) : na)
        r += 1
    if showShort and (z15) and 0.7 <= maxH
        table.cell(dash, 0, r, "S", text_color = color.red, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "82'038–82'587", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "15m", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "82'978", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(82037.74, 82586.89), text_color = color.white, text_size = ts, bgcolor = f_in(82037.74, 82586.89) ? color.new(color.red, 45) : na)
        r += 1
    if showLong and (zW1 or zD1 or zH4) and 17.6 <= maxH
        table.cell(dash, 0, r, "L", text_color = color.teal, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "67'741–82'377", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "W1/D1/H4", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "57'311", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(67740.66, 82377.32), text_color = color.white, text_size = ts, bgcolor = f_in(67740.66, 82377.32) ? color.new(color.teal, 45) : na)
        r += 1
    if (showZiel or showDV) and (z15)
        table.cell(dash, 0, r, "DV L", text_color = color.lime, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "76'214–77'940", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "15m", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(76213.52, 77940.44), text_color = color.white, text_size = ts, bgcolor = f_in(76213.52, 77940.44) ? color.new(color.lime, 45) : na)
        r += 1
    if (showZiel or showDV) and (zD1 or zH4 or z15)
        table.cell(dash, 0, r, "DV L", text_color = color.lime, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "77'555–79'401", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "D1/H4/15m", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(77554.66, 79400.74), text_color = color.white, text_size = ts, bgcolor = f_in(77554.66, 79400.74) ? color.new(color.lime, 45) : na)
        r += 1
    if dashFib
        table.cell(dash, 0, r, "Fib L", text_color = color.gray, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "81'182 / 79'715 / 79'106", text_color = color.gray, text_size = ts)
        table.cell(dash, 2, r, "50/62/67", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(79106.39, 81181.82), text_color = color.gray, text_size = ts)
        r += 1
        table.cell(dash, 0, r, "Fib S", text_color = color.gray, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "83'895 / 84'721 / 85'064", text_color = color.gray, text_size = ts)
        table.cell(dash, 2, r, "50/62/67", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(83894.61, 85063.97), text_color = color.gray, text_size = ts)
        r += 1
        table.cell(dash, 0, r, "D1 50", text_color = color.gray, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, f_zahl(d1sma) + " / " + f_zahl(d1ema), text_color = color.gray, text_size = ts)
        table.cell(dash, 2, r, "SMA/EMA", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(math.min(d1sma, d1ema), math.max(d1sma, d1ema)), text_color = color.gray, text_size = ts)
