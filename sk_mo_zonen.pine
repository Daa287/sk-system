var table dash = table.new(dashPos == "oben rechts" ? position.top_right : dashPos == "unten rechts" ? position.bottom_right : dashPos == "oben links" ? position.top_left : position.bottom_left, 5, 7, bgcolor = dashBg, border_width = 0, frame_width = 1, frame_color = color.new(color.gray, 70))
if barstate.islast and showDash
    table.cell(dash, 0, 0, "SK 23.11. 05:09", text_color = color.gray, text_size = ts)
    table.cell(dash, 1, 0, "Zone", text_color = color.gray, text_size = ts)
    table.cell(dash, 2, 0, "TF", text_color = color.gray, text_size = ts)
    table.cell(dash, 3, 0, "SL", text_color = color.gray, text_size = ts)
    table.cell(dash, 4, 0, "Kurs", text_color = color.gray, text_size = ts)
    table.clear(dash, 0, 1, 4, 6)
    int r = 1
    if showShort and (z15) and 2.8 <= maxH
        table.cell(dash, 0, r, "S", text_color = color.red, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "60'288–62'011", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "15m", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "63'239", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, br1 ? "gebrochen" : f_stat(60288.50, 62011.44), text_color = br1 ? color.gray : color.white, text_size = ts, bgcolor = not br1 and f_in(60288.50, 62011.44) ? color.new(color.red, 45) : na)
