    if showLiqH or showLiqV
        table.cell(dash, 0, r, "Liq ★ ↑", text_color = color.rgb(253, 231, 37), text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "62'732–63'161", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "HM+Mo ✓", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, lh7 ? "abgeholt" : f_stat(62732.00, 63161.00), text_color = lh7 ? color.gray : color.white, text_size = ts, bgcolor = not lh7 and f_in(62732.00, 63161.00) ? color.new(color.rgb(253, 231, 37), 45) : na)
        r += 1
    if showLiqH
