var table dash = table.new(dashPos == "oben rechts" ? position.top_right : dashPos == "unten rechts" ? position.bottom_right : dashPos == "oben links" ? position.top_left : position.bottom_left, 5, 8, bgcolor = dashBg, border_width = 0, frame_width = 1, frame_color = color.new(color.gray, 70))
if barstate.islast and showDash
    table.cell(dash, 0, 0, "SK 25.11. 17:09", text_color = color.gray, text_size = ts)
    table.cell(dash, 1, 0, "Zone", text_color = color.gray, text_size = ts)
    table.cell(dash, 2, 0, "TF", text_color = color.gray, text_size = ts)
    table.cell(dash, 3, 0, "SL", text_color = color.gray, text_size = ts)
    table.cell(dash, 4, 0, "Kurs", text_color = color.gray, text_size = ts)
    table.clear(dash, 0, 1, 4, 7)
    int r = 1
    if showShort and (z15) and 1.1 <= maxH
        table.cell(dash, 0, r, "S", text_color = color.red, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "58'994–59'614", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "15m", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "60'026", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, br0 ? "gebrochen" : f_stat(58993.96, 59613.66), text_color = br0 ? color.gray : color.white, text_size = ts, bgcolor = not br0 and f_in(58993.96, 59613.66) ? color.new(color.red, 45) : na)
        r += 1
    if (showZiel or false) and (z15)
        table.cell(dash, 0, r, "Ziel", text_color = color.orange, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "56'315–57'166", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "15m", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, false ? "" : f_stat(56315.16, 57165.76), text_color = false ? color.gray : color.white, text_size = ts, bgcolor = not false and f_in(56315.16, 57165.76) ? color.new(color.orange, 45) : na)
        r += 1
    if showLiqH or showLiqV
        table.cell(dash, 0, r, "Liq ★ ↑", text_color = color.rgb(253, 231, 37), text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "60'541–61'066", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "HM+Mo ✓", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, lh15 ? "abgeholt" : f_stat(60541.00, 61066.00), text_color = lh15 ? color.gray : color.white, text_size = ts, bgcolor = not lh15 and f_in(60541.00, 61066.00) ? color.new(color.rgb(253, 231, 37), 45) : na)
        r += 1
    if showLiqV
        table.cell(dash, 0, r, "Liq ★ ↓", text_color = color.rgb(253, 231, 37), text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "57'000", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "Mo ✓", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, lh29 ? "abgeholt" : f_stat(57000.00, 57000.00), text_color = lh29 ? color.gray : color.white, text_size = ts, bgcolor = not lh29 and f_in(57000.00, 57000.00) ? color.new(color.rgb(253, 231, 37), 45) : na)
        r += 1
    if dashFib
        table.cell(dash, 0, r, "Fib L", text_color = color.gray, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "59'867 / 58'749 / 58'285", text_color = color.gray, text_size = ts)
        table.cell(dash, 2, r, "50/62/67", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(58284.55, 59866.56), text_color = color.gray, text_size = ts)
        r += 1
        table.cell(dash, 0, r, "Fib S", text_color = color.gray, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "68'550 / 71'718 / 73'033", text_color = color.gray, text_size = ts)
        table.cell(dash, 2, r, "50/62/67", text_color = color.gray, text_size = ts)
