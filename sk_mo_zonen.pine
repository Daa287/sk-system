        table.cell(dash, 0, r, "Liq ★ ↓", text_color = color.rgb(253, 231, 37), text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "60'496–62'837", text_color = color.white, text_size = ts)
        table.cell(dash, 2, r, "HM+Mo ✓", text_color = color.gray, text_size = ts)
        table.cell(dash, 3, r, "", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, lh4 ? "abgeholt" : f_stat(60496.00, 62837.00), text_color = lh4 ? color.gray : color.white, text_size = ts, bgcolor = not lh4 and f_in(60496.00, 62837.00) ? color.new(color.rgb(253, 231, 37), 45) : na)
        r += 1
    if dashFib
        table.cell(dash, 0, r, "Fib S", text_color = color.gray, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, "73'452 / 76'153 / 77'275", text_color = color.gray, text_size = ts)
        table.cell(dash, 2, r, "50/62/67", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(73452.00, 77274.96), text_color = color.gray, text_size = ts)
        r += 1
        table.cell(dash, 0, r, "D1 50", text_color = color.gray, text_size = ts, text_halign = text.align_left)
        table.cell(dash, 1, r, f_zahl(d1sma) + " / " + f_zahl(d1ema), text_color = color.gray, text_size = ts)
        table.cell(dash, 2, r, "SMA/EMA", text_color = color.gray, text_size = ts)
        table.cell(dash, 4, r, f_stat(math.min(d1sma, d1ema), math.max(d1sma, d1ema)), text_color = color.gray, text_size = ts)
